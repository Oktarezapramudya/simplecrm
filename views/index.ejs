<!DOCTYPE html>
<html>
<head>
  <title>Daftar Pelanggan</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container py-4">
  <h1 class="mb-4">Daftar Pelanggan</h1>
  <a href="/tambah" class="btn btn-primary mb-3">Tambah Pelanggan</a>
  <table class="table table-striped">
    <thead>
      <tr>
        <th>ID</th>
        <th>Nama</th>
        <th>Email</th>
        <th>Telepon</th>
        <th>Tanggal Registrasi</th>
        <th>Aksi</th>
      </tr>
    </thead>
    <tbody>
      <% pelanggan.forEach(p => { %>
        <tr>
          <td><%= p.id %></td>
          <td><%= p.nama %></td>
          <td><%= p.email %></td>
          <td><%= p.telepon %></td>
          <td><%= p.tanggal_registrasi %></td>
          <td>
            <a href="/edit/<%= p.id %>" class="btn btn-sm btn-warning">Edit</a>
            <form action="/hapus/<%= p.id %>" method="POST" class="d-inline">
              <button type="submit" class="btn btn-sm btn-danger">Hapus</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</body>
</html>
