<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= button %> Pelanggan</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container py-4">
  <h1 class="mb-4"><%= button %> Pelanggan</h1>
  <form action="<%= action %>" method="POST" class="needs-validation" novalidate>
    <!-- Input Nama -->
    <div class="mb-3">
      <label class="form-label" for="nama">Nama</label>
      <input type="text" id="nama" name="nama" class="form-control" value="<%= pelanggan.nama || '' %>" required>
      <div class="invalid-feedback">
        Nama harus diisi.
      </div>
    </div>

    <!-- Input Email -->
    <div class="mb-3">
      <label class="form-label" for="email">Email</label>
      <input type="email" id="email" name="email" class="form-control" value="<%= pelanggan.email || '' %>" required>
      <div class="invalid-feedback">
        Mohon masukkan alamat email yang valid.
      </div>
    </div>

    <!-- Input Telepon -->
    <div class="mb-3">
      <label class="form-label" for="telepon">Telepon</label>
      <input type="tel" id="telepon" name="telepon" class="form-control" value="<%= pelanggan.telepon || '' %>"
        pattern="^\d{10,15}$" required>
      <div class="invalid-feedback">
        Nomor telepon tidak valid. Harap masukkan nomor telepon yang benar.
      </div>
    </div>

    <!-- Button Submit -->
    <button type="submit" class="btn btn-success"><%= button %></button>
    <a href="/" class="btn btn-secondary">Kembali</a>
  </form>

  <!-- JavaScript untuk Validasi Form -->
  <script>
    (() => {
      'use strict';
      const forms = document.querySelectorAll('.needs-validation');
      Array.from(forms).forEach(form => {
        form.addEventListener('submit', event => {
          if (!form.checkValidity()) {
            event.preventDefault();
            event.stopPropagation();
          }
          form.classList.add('was-validated');
        }, false);
      });
    })();
  </script>
  
</body>
</html>
